{
  "name": "@marketlens/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens, UI strings, formatting and API types shared by the Marketlens web and mobile apps.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tokens": "./src/tokens.ts",
    "./tokens.css": "./src/tokens.css",
    "./api": "./src/api/schema.ts",
    "./format": "./src/format.ts",
    "./detectLanguage": "./src/detectLanguage.ts",
    "./i18n/*": "./src/i18n/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../services/api/openapi/v1.json --output src/api/schema.ts",
    "generate:tokens": "node scripts/generate-tokens-css.ts"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "@types/node": "26.6.6"
  }
}
