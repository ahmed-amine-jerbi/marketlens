# Copy to .env and fill in what you have. Every value is optional for a local run:
# `docker compose up` works with none of them (stocks then use sample data, news is off).
# Never commit .env.

# --- Database (PostgreSQL) ---
# Used by the postgres container and, through DATABASE_URL, by the API.
POSTGRES_USER=marketlens
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=marketlens
# Npgsql connection string. Inside Docker Compose the host is `postgres`.
DATABASE_URL=Host=localhost;Port=5432;Database=marketlens;Username=marketlens;Password=change-me-local-only

# Base URL the web app is served from; used for links in confirmation and reset emails.
PUBLIC_BASE_URL=http://localhost:8080

# --- Market data providers (free tiers) ---
# Finnhub: live US stock trades, quotes, news. https://finnhub.io/register
FINNHUB_API_KEY=
# Twelve Data: daily stock and ETF history. https://twelvedata.com/register
TWELVEDATA_API_KEY=
# CoinGecko Demo: coin names and logos. https://www.coingecko.com/en/api
COINGECKO_DEMO_API_KEY=
# Binance public market data needs no key. api.binance.com blocks US IP addresses;
# override these if your server runs in the US.
BINANCE_MARKET_DATA_BASE_URL=https://data-api.binance.vision
BINANCE_STREAM_BASE_URL=wss://data-stream.binance.vision

# --- Forecaster (internal service) ---
FORECASTER_BASE_URL=http://localhost:8001

# --- Sign-in with Google (optional) ---
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Email (confirmation, password reset) ---
# Defaults point at Mailpit from docker-compose.yml (web UI on http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Marketlens <no-reply@marketlens.local>

# --- Web Push for browser price alerts ---
# Generate a key pair once, e.g. `npx web-push generate-vapid-keys`.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:you@your-domain

# --- Optional ---
# MaxMind GeoLite2 key for choosing a language and currency from the visitor's country.
# Without it the app uses the device's language and region.
MAXMIND_LICENSE_KEY=
# Expo access token, only if Expo push security is enabled on your Expo account.
EXPO_ACCESS_TOKEN=
