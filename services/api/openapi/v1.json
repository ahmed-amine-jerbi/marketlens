{
  "openapi": "3.1.1",
  "info": {
    "title": "Marketlens API",
    "description": "Live currency, crypto, stock and ETF prices, conversions between any two assets, and chart history. Prices are decimal strings; errors are RFC 9457 problem details with urn:marketlens:problem:* types.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/assets": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "List tracked assets, filtered by class or text, in pages ordered by key",
        "operationId": "ListAssets",
        "parameters": [
          {
            "name": "class",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assets/{key}": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "Get one asset with its latest quote in a display currency",
        "operationId": "GetAsset",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "in",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quotes": {
      "get": {
        "tags": [
          "Quotes"
        ],
        "summary": "Get the latest quotes of up to 50 assets in one display currency",
        "operationId": "GetQuotes",
        "parameters": [
          {
            "name": "keys",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "in",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QuoteResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversions": {
      "get": {
        "tags": [
          "Conversions"
        ],
        "summary": "Convert an amount between any two tracked assets",
        "operationId": "Convert",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "schema": {
              "pattern": "^-?[0-9]\u002B(\\.[0-9]\u002B)?$",
              "type": [
                "null",
                "string"
              ],
              "format": "decimal"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assets/{key}/history": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "Get an asset\u0027s price history for a chart range in a display currency",
        "operationId": "GetAssetHistory",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "range",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "in",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversions/history": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "Get the rate between two assets over a chart range",
        "operationId": "GetConversionHistory",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "range",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "Show how current each data source is",
        "operationId": "GetStatus",
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/locale-suggestion": {
      "get": {
        "tags": [
          "Locale"
        ],
        "summary": "Suggest a language and display currency for a visitor who has not chosen",
        "operationId": "GetLocaleSuggestion",
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocaleSuggestion"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetClass": {
        "enum": [
          "fiat",
          "crypto",
          "stock",
          "etf"
        ]
      },
      "AssetDetailResponse": {
        "required": [
          "asset",
          "quote"
        ],
        "type": "object",
        "properties": {
          "asset": {
            "$ref": "#/components/schemas/AssetResponse"
          },
          "quote": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/QuoteResponse"
              }
            ]
          }
        }
      },
      "AssetKey": {
        "pattern": "^[a-z]\u002B:[A-Z0-9][A-Z0-9.\\-]{0,14}$",
        "type": "string",
        "description": "Stable identifier of an asset across the API, database and clients: the class, a colon and the\r\nsymbol, for example \u0060fiat:EUR\u0060, \u0060crypto:BTC\u0060, \u0060stock:BRK.B\u0060, \u0060etf:SPY\u0060."
      },
      "AssetPage": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetResponse"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AssetResponse": {
        "required": [
          "key",
          "class",
          "symbol",
          "name",
          "logoUrl",
          "tracks"
        ],
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/AssetKey"
          },
          "class": {
            "$ref": "#/components/schemas/AssetClass"
          },
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "logoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "tracks": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChangeBasis": {
        "enum": [
          "previous-close",
          "rolling-24h"
        ],
        "description": "What a quote\u0027s change is measured against (D40)."
      },
      "ConversionLegResponse": {
        "required": [
          "key",
          "priceUsd",
          "asOfUtc",
          "source",
          "freshness"
        ],
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/AssetKey"
          },
          "priceUsd": {
            "pattern": "^-?[0-9]\u002B(\\.[0-9]\u002B)?$",
            "type": "string",
            "format": "decimal"
          },
          "asOfUtc": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          }
        }
      },
      "ConversionResponse": {
        "required": [
          "from",
          "to",
          "rate",
          "amount",
          "convertedAmount",
          "changePct",
          "asOfUtc",
          "freshness",
          "legs"
        ],
        "type": "object",
        "properties": {
          "from": {
            "$ref": "#/components/schemas/AssetKey"
          },
          "to": {
            "$ref": "#/components/schemas/AssetKey"
          },
          "rate": {
            "pattern": "^-?[0-9]\u002B(\\.[0-9]\u002B)?$",
            "type": "string",
            "format": "decimal"
          },
          "amount": {
            "pattern": "^-?[0-9]\u002B(\\.[0-9]\u002B)?$",
            "type": "string",
            "format": "decimal"
          },
          "convertedAmount": {
            "pattern": "^-?[0-9]\u002B(\\.[0-9]\u002B)?$",
            "type": "string",
            "format": "decimal"
          },
          "changePct": {
            "pattern": "^-?[0-9]\u002B(\\.[0-9]\u002B)?$",
            "type": [
              "null",
              "string"
            ],
            "format": "decimal"
          },
          "asOfUtc": {
            "type": "string",
            "format": "date-time"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          },
          "legs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConversionLegResponse"
            }
          }
        }
      },
      "Freshness": {
        "enum": [
          "live",
          "delayed",
          "daily"
        ],
        "description": "How current a price is. Ordered from freshest to slowest."
      },
      "HistoryPoint": {
        "required": [
          "t",
          "close"
        ],
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "close": {
            "pattern": "^-?[0-9]\u002B(\\.[0-9]\u002B)?$",
            "type": "string",
            "format": "decimal"
          }
        }
      },
      "HistoryResponse": {
        "required": [
          "interval",
          "in",
          "points"
        ],
        "type": "object",
        "properties": {
          "interval": {
            "type": "string"
          },
          "in": {
            "$ref": "#/components/schemas/AssetKey"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryPoint"
            }
          }
        }
      },
      "LocaleSuggestion": {
        "required": [
          "language",
          "displayCurrency",
          "reason"
        ],
        "type": "object",
        "properties": {
          "language": {
            "type": "string"
          },
          "displayCurrency": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "QuoteResponse": {
        "required": [
          "key",
          "price",
          "in",
          "changePct",
          "changeBasis",
          "asOfUtc",
          "source",
          "freshness"
        ],
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/AssetKey"
          },
          "price": {
            "pattern": "^-?[0-9]\u002B(\\.[0-9]\u002B)?$",
            "type": "string",
            "format": "decimal"
          },
          "in": {
            "$ref": "#/components/schemas/AssetKey"
          },
          "changePct": {
            "pattern": "^-?[0-9]\u002B(\\.[0-9]\u002B)?$",
            "type": [
              "null",
              "string"
            ],
            "format": "decimal"
          },
          "changeBasis": {
            "$ref": "#/components/schemas/ChangeBasis"
          },
          "asOfUtc": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          }
        },
        "description": "An asset\u0027s price expressed in a display currency (In), as clients receive it."
      },
      "SourceStatus": {
        "required": [
          "source",
          "quoteCount",
          "newestAsOfUtc",
          "oldestAsOfUtc",
          "freshness"
        ],
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "quoteCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "newestAsOfUtc": {
            "type": "string",
            "format": "date-time"
          },
          "oldestAsOfUtc": {
            "type": "string",
            "format": "date-time"
          },
          "freshness": {
            "$ref": "#/components/schemas/Freshness"
          }
        }
      },
      "StatusResponse": {
        "required": [
          "checkedAtUtc",
          "stockData",
          "sources"
        ],
        "type": "object",
        "properties": {
          "checkedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "stockData": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Assets",
      "description": "The currencies, coins, stocks and ETFs Marketlens tracks."
    },
    {
      "name": "Quotes",
      "description": "Latest prices in any display currency."
    },
    {
      "name": "Conversions",
      "description": "Amounts converted between any two assets."
    },
    {
      "name": "History",
      "description": "Chart history, converted point by point."
    },
    {
      "name": "Status",
      "description": "Freshness of each data source."
    },
    {
      "name": "Locale",
      "description": "Language and currency suggestions for new visitors."
    }
  ]
}
